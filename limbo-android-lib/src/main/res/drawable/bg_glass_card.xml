<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass card surface: translucent gradient + 1dp rim -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:startColor="#1BFFFFFF"
        android:centerColor="#10FFFFFF"
        android:endColor="#09FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#26FFFFFF" />
</shape>
