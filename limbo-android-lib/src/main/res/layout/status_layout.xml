<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/statusm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="18dp"
    tools:showIn="@layout/limbo_main">

    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp">

        <ImageView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:background="@drawable/bg_status_ring"
            android:contentDescription="@string/statusStopped" />

        <ImageView
            android:id="@+id/statusVal"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_power"
            android:tint="@color/limbo_text_muted" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/statusStr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/statusStopped"
            android:textColor="@color/limbo_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/status_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/appSubtitle"
            style="@style/Limbo.Text.Summary" />
    </LinearLayout>

    <TextView
        android:id="@+id/status_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_chip_neutral"
        android:paddingLeft="12dp"
        android:paddingTop="5dp"
        android:paddingRight="12dp"
        android:paddingBottom="5dp"
        android:text="@string/statusStopped"
        android:textColor="@color/limbo_text_dim"
        android:textSize="11sp" />

</LinearLayout>
