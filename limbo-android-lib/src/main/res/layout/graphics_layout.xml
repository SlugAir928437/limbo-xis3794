<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/graphicssectionl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="18dp"
    tools:showIn="@layout/limbo_main">

    <LinearLayout
        android:id="@+id/graphicsheaderl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_chip"
            android:contentDescription="@string/GraphicsLabel"
            android:padding="7dp"
            android:src="@drawable/ic_tab_display"
            android:tint="@color/limbo_accent" />

        <TextView
            android:id="@+id/graphicssectionStr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="@string/GraphicsLabel"
            style="@style/Limbo.Text.Section" />

        <TextView
            android:id="@+id/graphicssectionsummaryStr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="2"
            android:maxWidth="150dp"
            android:ellipsize="end"
            android:text=""
            style="@style/Limbo.Text.Summary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/graphicssectionDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/vgacfgl"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/vgacfgStr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/VideoDisplayLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/vgacfgval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
