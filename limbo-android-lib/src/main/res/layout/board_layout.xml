<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cpusectionl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="18dp"
    tools:showIn="@layout/limbo_main">

    <LinearLayout
        android:id="@+id/cpusectionheaderl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_chip"
            android:contentDescription="@string/BoardLabel"
            android:padding="7dp"
            android:src="@drawable/ic_tab_cpu"
            android:tint="@color/limbo_accent" />

        <TextView
            android:id="@+id/cpusectionStr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="@string/BoardLabel"
            style="@style/Limbo.Text.Section" />

        <TextView
            android:id="@+id/cpusectionsummaryStr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="2"
            android:maxWidth="150dp"
            android:ellipsize="end"
            android:text=""
            style="@style/Limbo.Text.Summary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cpusectionDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/machinetypel"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/machinetypeStr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/MachineTypeLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/machinetypeval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cpul"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/cpuStr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/CpuModelLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/cpuval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <!-- Stepless CPU cores -->
        <LinearLayout
            android:id="@+id/cpunuml"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cpunumStr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/CpuCoresLabel"
                    style="@style/Limbo.Text.Row" />

                <TextView
                    android:id="@+id/cpunum_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_value_chip"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:text="1"
                    style="@style/Limbo.Text.Value" />
            </LinearLayout>

            <com.max2idea.android.limbo.ui.SteplessSlider
                android:id="@+id/cpunum_slider"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="2dp" />

            <Spinner
                android:id="@+id/cpunumval"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible" />
        </LinearLayout>

        <!-- Stepless RAM -->
        <LinearLayout
            android:id="@+id/rammeml"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rammemStr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/MemoryMbLabel"
                    style="@style/Limbo.Text.Row" />

                <TextView
                    android:id="@+id/rammem_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_value_chip"
                    android:paddingLeft="10dp"
                    android:paddingTop="4dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="4dp"
                    android:text="128 MB"
                    style="@style/Limbo.Text.Value" />
            </LinearLayout>

            <com.max2idea.android.limbo.ui.SteplessSlider
                android:id="@+id/rammem_slider"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="2dp" />

            <Spinner
                android:id="@+id/rammemval"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="invisible" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="6dp" />

        <LinearLayout
            android:id="@+id/accell"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/mttcgl"
                style="@style/Limbo.Row">

                <TextView
                    android:id="@+id/enablemttcgstr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/enableMTTCG"
                    style="@style/Limbo.Text.Row" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/enablemttcgval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/kvml"
                style="@style/Limbo.Row">

                <TextView
                    android:id="@+id/enablekvmstr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/EnableKVM"
                    style="@style/Limbo.Text.Row" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/enablekvmval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timersl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/hpetl"
                style="@style/Limbo.Row">

                <TextView
                    android:id="@+id/hpetStr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/DisableHpetLabel"
                    style="@style/Limbo.Text.Row" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/hpetval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tscl"
                style="@style/Limbo.Row">

                <TextView
                    android:id="@+id/tscStr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/DisableTscLabel"
                    style="@style/Limbo.Text.Row" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/tscval"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/othersl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/acpil"
                style="@style/Limbo.Row">

                <TextView
                    android:id="@+id/acpiStr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/DisableAcpiLabel"
                    style="@style/Limbo.Text.Row" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/acpival"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:minHeight="0dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
