<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/machinel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="16dp"
    tools:showIn="@layout/limbo_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <TextView
                android:id="@+id/machine_letter"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_icon_chip"
                android:gravity="center"
                android:textColor="@color/limbo_accent"
                android:textSize="24sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/machine_icon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_icon_chip"
                android:scaleType="centerCrop"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/machineStr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_short_name"
                style="@style/Limbo.Text.Title" />

            <TextView
                android:id="@+id/machine_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/machineProfile"
                style="@style/Limbo.Text.Summary" />
        </LinearLayout>
    </LinearLayout>

    <!-- data holder for the machine list, kept invisible -->
    <Spinner
        android:id="@+id/machineval"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible" />

</LinearLayout>
