<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bootSectionl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="18dp"
    tools:showIn="@layout/limbo_main">

    <LinearLayout
        android:id="@+id/bootheaderl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_chip"
            android:contentDescription="@string/BootLabel"
            android:padding="7dp"
            android:src="@drawable/ic_power"
            android:tint="@color/limbo_accent" />

        <TextView
            android:id="@+id/bootsectionStr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="@string/BootLabel"
            style="@style/Limbo.Text.Section" />

        <TextView
            android:id="@+id/bootsectionsummaryStr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="2"
            android:maxWidth="150dp"
            android:ellipsize="end"
            android:text=""
            style="@style/Limbo.Text.Summary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bootsectionDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/bootfroml"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/bootfromstr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/BootFromLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/bootfromval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/firmwarel"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/firmwarestr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/FirmwareLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/firmwareval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/kernell"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/kernelStr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/KernelLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/kernelval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/initrdl"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/initrdStr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/InitrdLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/initrdval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/appendl"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/appendStr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="@string/AppendLabel"
                style="@style/Limbo.Text.Row" />

            <EditText
                android:id="@+id/appendval"
                android:gravity="end"
                android:hint="@string/AppendHintLabel"
                style="@style/Limbo.EditText" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
