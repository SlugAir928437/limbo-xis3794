<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/storagesectionl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="18dp"
    tools:showIn="@layout/limbo_main">

    <LinearLayout
        android:id="@+id/storageheaderl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_chip"
            android:contentDescription="@string/DisksLabel"
            android:padding="7dp"
            android:src="@drawable/ic_tab_storage"
            android:tint="@color/limbo_accent" />

        <TextView
            android:id="@+id/storagesectionStr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="@string/DisksLabel"
            style="@style/Limbo.Text.Section" />

        <TextView
            android:id="@+id/storagesectionsummaryStr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="2"
            android:maxWidth="150dp"
            android:ellipsize="end"
            android:text=""
            style="@style/Limbo.Text.Summary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/storagesectionDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/hdaimgl"
            style="@style/Limbo.Row">

            <ImageView
                android:id="@+id/hdaoptions"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_icon_chip"
                android:contentDescription="@string/SelectLabel"
                android:padding="6dp"
                android:src="@drawable/ic_tune"
                android:tint="@color/limbo_accent" />

            <TextView
                android:id="@+id/hdaimgstr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:text="@string/HardDiskALabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/hdaimgval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hdbimgl"
            style="@style/Limbo.Row">

            <ImageView
                android:id="@+id/hdboptions"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_icon_chip"
                android:contentDescription="@string/SelectLabel"
                android:padding="6dp"
                android:src="@drawable/ic_tune"
                android:tint="@color/limbo_accent" />

            <TextView
                android:id="@+id/hdbimgstr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:text="@string/HardDiskBLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/hdbimgval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hdcimgl"
            style="@style/Limbo.Row">

            <ImageView
                android:id="@+id/hdcoptions"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_icon_chip"
                android:contentDescription="@string/SelectLabel"
                android:padding="6dp"
                android:src="@drawable/ic_tune"
                android:tint="@color/limbo_accent" />

            <TextView
                android:id="@+id/hdcimgstr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:text="@string/HardDiskCLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/hdcimgval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hddimgl"
            style="@style/Limbo.Row">

            <ImageView
                android:id="@+id/hddoptions"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_icon_chip"
                android:contentDescription="@string/SelectLabel"
                android:padding="6dp"
                android:src="@drawable/ic_tune"
                android:tint="@color/limbo_accent" />

            <TextView
                android:id="@+id/hddimgstr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:text="@string/HardDiskDLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/hddimgval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sharedfolderl"
            style="@style/Limbo.Row">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_icon_chip"
                android:contentDescription="@string/SharedFolderLabel"
                android:padding="6dp"
                android:src="@drawable/ic_tab_storage"
                android:tint="@color/limbo_accent" />

            <TextView
                android:id="@+id/sharedfolderstr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:text="@string/SharedFolderLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/sharedfolderval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
