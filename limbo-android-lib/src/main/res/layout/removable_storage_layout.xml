<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/removablestoragesectionl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="18dp"
    tools:showIn="@layout/limbo_main">

    <LinearLayout
        android:id="@+id/removablestorageheaderl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_chip"
            android:contentDescription="@string/RemovableLabel"
            android:padding="7dp"
            android:src="@drawable/ic_tab_storage"
            android:tint="@color/limbo_accent" />

        <TextView
            android:id="@+id/removableStoragesectionStr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="@string/RemovableLabel"
            style="@style/Limbo.Text.Section" />

        <TextView
            android:id="@+id/removablesectionsummaryStr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="2"
            android:maxWidth="150dp"
            android:ellipsize="end"
            android:text=""
            style="@style/Limbo.Text.Summary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/removableStoragesectionDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/cdromimgl"
            style="@style/Limbo.Row">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/cdromimgcheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <TextView
                android:id="@+id/cdromimgstr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:text="@string/CdromLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/cdromimgval"
                style="@style/Limbo.Spinner" />

            <ImageView
                android:id="@+id/cdromoptions"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginLeft="4dp"
                android:background="@drawable/bg_icon_chip"
                android:contentDescription="@string/SelectLabel"
                android:padding="6dp"
                android:src="@drawable/ic_tune"
                android:tint="@color/limbo_accent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/floppyimgl"
            style="@style/Limbo.Row">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/floppyimgcheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <TextView
                android:id="@+id/floppyimgstr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:text="@string/FloppyALabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/floppyimgval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/floppybimgl"
            style="@style/Limbo.Row">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/floppybimgcheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <TextView
                android:id="@+id/floppybimgstr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:text="@string/FloppyBLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/floppybimgval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sdcardimgl"
            style="@style/Limbo.Row">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/sdcardimgcheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:minHeight="0dp" />

            <TextView
                android:id="@+id/sdcardimgstr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_weight="1"
                android:text="@string/SdCardLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/sdcardimgval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
