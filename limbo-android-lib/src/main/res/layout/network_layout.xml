<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/networksectionl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="18dp"
    tools:showIn="@layout/limbo_main">

    <LinearLayout
        android:id="@+id/networkheaderl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_chip"
            android:contentDescription="@string/NetworkLabel"
            android:padding="7dp"
            android:src="@drawable/ic_tab_network"
            android:tint="@color/limbo_accent" />

        <TextView
            android:id="@+id/networksectionStr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="@string/NetworkLabel"
            style="@style/Limbo.Text.Section" />

        <TextView
            android:id="@+id/networksectionsummaryStr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="2"
            android:maxWidth="150dp"
            android:ellipsize="end"
            android:text=""
            style="@style/Limbo.Text.Summary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/networksectionDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/netcfgl"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/netcfgStr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/NetworkModeLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/netcfgval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/netDeviceslm"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/netDevicesStr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/NetworkCardLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/netDevicesVal"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dnsl"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/dnsStr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="@string/DnsServerLabel"
                style="@style/Limbo.Text.Row" />

            <EditText
                android:id="@+id/dnsval"
                android:gravity="end"
                style="@style/Limbo.EditText" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hostfwdl"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/hostfwdStr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="10dp"
                android:text="@string/HostForwardLabel"
                style="@style/Limbo.Text.Row" />

            <EditText
                android:id="@+id/hostfwdval"
                android:gravity="end"
                style="@style/Limbo.EditText" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
