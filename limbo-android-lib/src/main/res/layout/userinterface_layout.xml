<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/userInterfaceSectionl"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_glass_card"
    android:orientation="vertical"
    android:padding="18dp"
    tools:showIn="@layout/limbo_main">

    <LinearLayout
        android:id="@+id/userinterfaceheaderl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_icon_chip"
            android:contentDescription="@string/UserInterfaceLabel"
            android:padding="7dp"
            android:src="@drawable/ic_ui"
            android:tint="@color/limbo_accent" />

        <TextView
            android:id="@+id/userInterfaceSectionStr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_weight="1"
            android:text="@string/UserInterfaceLabel"
            style="@style/Limbo.Text.Section" />

        <TextView
            android:id="@+id/uisectionsummaryStr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:maxLines="2"
            android:maxWidth="150dp"
            android:ellipsize="end"
            android:text=""
            style="@style/Limbo.Text.Summary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/userInterfaceDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/uil"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/uiStr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/DisplayLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/uival"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/keyboard"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/keyboardstr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/KeyboardLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/keyboardval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/mouse"
            style="@style/Limbo.Row">

            <TextView
                android:id="@+id/mousestr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/MouseLabel"
                style="@style/Limbo.Text.Row" />

            <Spinner
                android:id="@+id/mouseval"
                style="@style/Limbo.Spinner" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
